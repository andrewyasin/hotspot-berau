name: Scrape hotspot BMKG - Berau

on:
  schedule:
    # 01:30, 07:30, 13:30 WITA -> 17:30, 23:30, 05:30 UTC (WITA = UTC+8)
    - cron: '30 17,23,5 * * *'
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  scrape:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Jalankan scraper
        run: python scripts/scrape.py

      - name: Commit perubahan data
        run: |
          git config user.name "hotspot-berau-bot"
          git config user.email "actions@users.noreply.github.com"
          git add data/
          git diff --quiet --cached || git commit -m "chore: update data hotspot $(date -u +'%Y-%m-%d %H:%M UTC')"
          git push
